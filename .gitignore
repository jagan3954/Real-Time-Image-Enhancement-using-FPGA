# =====================================
# Vivado Generated Files (IGNORE)
# =====================================

vivado/**/*.cache/
vivado/**/*.gen/
vivado/**/*.runs/
vivado/**/*.hw/
vivado/**/*.ip_user_files/
vivado/**/*.sim/

# Vivado logs and temporary files
*.jou
*.log
*.str
*.tmp
*.backup
.Xil

# =====================================
# Simulation Files (IGNORE)
# =====================================

*.wdb
*.vcd

# =====================================
# Python Cache (IGNORE)
# =====================================

__pycache__/
*.pyc

# =====================================
# Bitstreams (IGNORE BY DEFAULT)
# =====================================

*.bit
*.bin
*.hwh

# =====================================
# Exceptions (TRACK THESE)
# =====================================

!Bitstreamfiles/
!Bitstreamfiles/*.bit
!Bitstreamfiles/*.hwh

# =====================================
# KEEP IMPORTANT VIVADO FILES
# =====================================

# These are NOT ignored:
# *.xpr
# *.srcs/
# *.bd
# *.bda
# *.xci
# *.xdc
