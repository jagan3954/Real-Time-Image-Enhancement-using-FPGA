# =========================
# Vivado Generated Junk
# =========================

*.cache
*.gen
*.runs
*.hw
*.ip_user_files
*.jou
*.log
*.str
*.tmp
*.backup
.Xil
*.sim/

# Ignore simulation junk only
*.wdb
*.vcd

vivado/**/*.cache/
vivado/**/*.gen/
vivado/**/*.runs/
vivado/**/*.hw/
vivado/**/*.ip_user_files/
vivado/**/*.sim/

# Ignore bitstreams
*.bit
*.bin

# Python
__pycache__/
*.pyc

# =========================
# Exceptions (Files we WANT)
# =========================

# Allow the Bitstream folder and everything inside it
!Bitstreamfiles/
!Bitstreamfiles/*.bit
!Bitstreamfiles/*.hwh
